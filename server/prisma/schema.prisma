// =============================================================================
// FreelanceHub — Final Prisma Schema
// STEP 1: Complete Relational Database Architecture
// =============================================================================
// IMPORTANT: The existing User model and all auth functionality are preserved.
// This schema only ADDS new models — it does NOT break existing auth/admin code.
// =============================================================================

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// ENUMS
// =============================================================================

/// User role — controls authorization throughout the platform
enum Role {
  CUSTOMER
  FREELANCER
  ADMIN
}

/// Account status — used by auth middleware and admin moderation
enum Status {
  ACTIVE
  BLOCKED
}

/// Freelancer experience tier
enum ExperienceLevel {
  ENTRY
  INTERMEDIATE
  EXPERT
}

/// Freelancer work availability
enum Availability {
  FULL_TIME
  PART_TIME
  NOT_AVAILABLE
}

/// Lifecycle state of a client project posting
enum ProjectStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// State of a freelancer's proposal on a project
enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

/// State of a contract between client and freelancer
enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED
}

/// Admin moderation state of a user-filed report
enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

/// State of a payment record linked to a contract
enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

/// Type of freelancer-to-freelancer collaboration
enum CollaborationType {
  INTERNSHIP
  PROJECT_COLLABORATION
  FREELANCE_ASSISTANCE
  CO_FREELANCER
  MENTORSHIP
}

/// Work mode for collaboration
enum WorkMode {
  REMOTE
  ON_SITE
  HYBRID
}

/// Compensation type for collaboration
enum CompensationType {
  UNPAID
  PAID
  NEGOTIABLE
}

/// Lifecycle state of a collaboration opportunity
enum CollaborationStatus {
  OPEN
  ACTIVE
  COMPLETED
  CANCELLED
}

/// State of an application to a collaboration opportunity
enum CollaborationApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

/// Status of a customer support ticket
enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

/// Category for support tickets
enum SupportCategory {
  ACCOUNT
  PAYMENTS
  PROJECT
  FREELANCER
  CUSTOMER
  CONTRACT
  TECHNICAL
  OTHER
}

/// Priority of a support ticket
enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// =============================================================================
// MODULE 0 — USER / AUTHENTICATION (PRESERVED EXACTLY)
// =============================================================================

/// Central identity and authentication entity.
/// ALL roles (CUSTOMER, FREELANCER, ADMIN) are represented as User records.
/// Do NOT create separate auth tables for each role.
model User {
  id                Int      @id @default(autoincrement())
  name              String
  email             String   @unique
  passwordHash      String
  role              Role     @default(CUSTOMER)
  status            Status   @default(ACTIVE)
  professionalTitle String?  // Optional — stored at User level for quick access on login/JWT
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // ── Role-specific profiles (1:0..1) ──────────────────────────────────────
  customerProfile   CustomerProfile?
  freelancerProfile FreelancerProfile?

  // ── Projects posted by this user as a client (1:many) ────────────────────
  projects          Project[]

  // ── Messages sent by this user (1:many) ──────────────────────────────────
  sentMessages      Message[]

  // ── Conversations this user participates in ───────────────────────────────
  conversations     ConversationParticipant[]

  // ── Reviews written BY this user ─────────────────────────────────────────
  reviewsGiven      Review[] @relation("ReviewerRelation")

  // ── Reviews received by this user (as the reviewed party) ────────────────
  reviewsReceived   Review[] @relation("ReviewedRelation")

  // ── Reports filed BY this user ────────────────────────────────────────────
  reportsFiled      Report[] @relation("ReporterRelation")

  // ── Reports filed AGAINST this user ──────────────────────────────────────
  reportsReceived   Report[] @relation("ReportedRelation")

  // ── Reports resolved by this admin user ──────────────────────────────────
  reportsResolved   Report[] @relation("ResolverRelation")

  // ── Contracts as customer ─────────────────────────────────────────────────
  contractsAsClient     Contract[] @relation("ContractClientRelation")

  // ── Contracts as freelancer ───────────────────────────────────────────────
  contractsAsFreelancer Contract[] @relation("ContractFreelancerRelation")

  // ── Payments made as payer ────────────────────────────────────────────────
  paymentsMade      Payment[] @relation("PayerRelation")

  // ── Payments received ─────────────────────────────────────────────────────
  paymentsReceived  Payment[] @relation("ReceiverRelation")

  // ── Collaboration opportunities created by this user ─────────────────────
  collaborationsCreated      CollaborationOpportunity[] @relation("CollabCreatorRelation")

  // ── Collaboration applications submitted by this user ───────────────────
  collaborationApplications  CollaborationApplication[] @relation("CollabApplicantRelation")

  // ── Verified collaborations as participating freelancer ──────────────────
  verifiedCollaborationsAsFreelancer VerifiedCollaboration[] @relation("VerifiedCollabFreelancer")

  // ── Verified collaborations as partner/creator ───────────────────────────
  verifiedCollaborationsAsPartner    VerifiedCollaboration[] @relation("VerifiedCollabPartner")

  // ── Support tickets filed by this user ───────────────────────────────────
  supportTickets             SupportTicket[] @relation("TicketUserRelation")

  // ── Support tickets resolved by this admin ───────────────────────────────
  ticketsResolved            SupportTicket[] @relation("TicketResolverRelation")

  // ── Canonical direct conversations ───────────────────────────────────────
  customerConversations      Conversation[]  @relation("CustomerConversations")
  freelancerConversations    Conversation[]  @relation("FreelancerConversations")
  collabF1Conversations      Conversation[]  @relation("CollabF1Conversations")
  collabF2Conversations      Conversation[]  @relation("CollabF2Conversations")

  // ── Indexes ───────────────────────────────────────────────────────────────
  @@index([role])
  @@index([status])
  @@index([role, status])
}

// =============================================================================
// MODULE 1 — CUSTOMER PROFILE
// =============================================================================

/// Extended client/customer profile. Supplements User authentication record.
/// One-to-one with User (CUSTOMER role).
model CustomerProfile {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  bio          String?  @db.Text
  companyName  String?
  location     String?
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =============================================================================
// MODULE 2 — FREELANCER PROFILE + PORTFOLIO
// =============================================================================

/// Detailed freelancer profile for marketplace visibility.
/// One-to-one with User (FREELANCER role).
model FreelancerProfile {
  id              Int              @id @default(autoincrement())
  userId          Int              @unique
  bio             String?          @db.Text
  hourlyRate      Decimal?         @db.Decimal(10, 2)
  experienceLevel ExperienceLevel  @default(ENTRY)
  location        String?
  availability    Availability     @default(FULL_TIME)
  profileImage    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills          FreelancerSkill[]
  portfolioProjects PortfolioProject[]
  proposals       Proposal[]

  @@index([userId])
  @@index([experienceLevel])
  @@index([availability])
  @@index([hourlyRate])
  @@index([location])
}

// =============================================================================
// MODULE 2 — SKILLS (Normalized lookup table)
// =============================================================================

/// Normalized skill entity. Shared across freelancers and projects.
model Skill {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  createdAt   DateTime @default(now())

  freelancers FreelancerSkill[]
  projects    ProjectSkill[]
  portfolios  PortfolioProjectSkill[]

  @@index([name])
}

/// Junction table: FreelancerProfile <-> Skill (many-to-many)
model FreelancerSkill {
  freelancerProfileId Int
  skillId             Int
  assignedAt          DateTime @default(now())

  freelancerProfile FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  skill             Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([freelancerProfileId, skillId])
  @@index([skillId])
  @@index([freelancerProfileId])
}

// =============================================================================
// MODULE 2 — PORTFOLIO
// =============================================================================

/// Individual portfolio work item belonging to a freelancer.
model PortfolioProject {
  id                  Int      @id @default(autoincrement())
  freelancerProfileId Int
  title               String
  description         String?  @db.Text
  projectUrl          String?
  imageUrl            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  freelancerProfile   FreelancerProfile       @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  skills              PortfolioProjectSkill[]

  @@index([freelancerProfileId])
}

/// Junction table: PortfolioProject <-> Skill (many-to-many)
model PortfolioProjectSkill {
  portfolioProjectId Int
  skillId            Int

  portfolioProject PortfolioProject @relation(fields: [portfolioProjectId], references: [id], onDelete: Cascade)
  skill            Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([portfolioProjectId, skillId])
  @@index([skillId])
  @@index([portfolioProjectId])
}

// =============================================================================
// MODULE 3 — PROJECT / JOB POSTING
// =============================================================================

/// Normalized project category lookup table.
model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())

  projects  Project[]

  @@index([name])
}

/// A client's posted freelance project/job.
model Project {
  id              Int             @id @default(autoincrement())
  clientId        Int
  categoryId      Int?
  title           String
  description     String          @db.Text
  budget          Decimal?        @db.Decimal(10, 2)
  deadline        DateTime?
  experienceLevel ExperienceLevel @default(ENTRY)
  status          ProjectStatus   @default(OPEN)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  client          User            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  category        Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  requiredSkills  ProjectSkill[]
  proposals       Proposal[]
  contract        Contract?
  review          Review?
  reports         Report[]        @relation("ReportProjectRelation")
  supportTickets  SupportTicket[] @relation("TicketProjectRelation")
  collaborations  CollaborationOpportunity[]

  @@index([clientId])
  @@index([categoryId])
  @@index([status])
  @@index([budget])
  @@index([experienceLevel])
  @@index([deadline])
  @@index([status, categoryId])
}

/// Junction table: Project <-> Skill (many-to-many)
model ProjectSkill {
  projectId Int
  skillId   Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
  @@index([projectId])
}

// =============================================================================
// MODULE 5 — PROPOSALS
// =============================================================================

/// A freelancer's proposal/bid on a client project.
model Proposal {
  id                  Int            @id @default(autoincrement())
  projectId           Int
  freelancerProfileId Int
  coverLetter         String?        @db.Text
  proposedPrice       Decimal        @db.Decimal(10, 2)
  estimatedDays       Int?
  status              ProposalStatus @default(PENDING)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  project           Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  freelancerProfile FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Restrict)
  contract          Contract?

  @@unique([projectId, freelancerProfileId])
  @@index([projectId])
  @@index([freelancerProfileId])
  @@index([status])
  @@index([proposedPrice])
}

// =============================================================================
// MODULE 8 — CONTRACT / PROJECT MANAGEMENT
// =============================================================================

/// Active working engagement between client and freelancer.
model Contract {
  id           Int            @id @default(autoincrement())
  projectId    Int            @unique
  proposalId   Int            @unique
  clientId     Int
  freelancerId Int
  agreedAmount Decimal        @db.Decimal(10, 2)
  startDate    DateTime       @default(now())
  endDate      DateTime?
  status       ContractStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  client     User     @relation("ContractClientRelation", fields: [clientId], references: [id], onDelete: Restrict)
  freelancer User     @relation("ContractFreelancerRelation", fields: [freelancerId], references: [id], onDelete: Restrict)
  review     Review?
  payment    Payment?

  @@index([clientId])
  @@index([freelancerId])
  @@index([status])
}

// =============================================================================
// MODULE 7 — MESSAGING
// =============================================================================

/// A conversation thread between users.
/// Supports two canonical types:
///   1. Customer ↔ Freelancer: identified by customerId + freelancerId
///   2. Freelancer ↔ Freelancer (collaboration only): identified by collabFreelancer1Id + collabFreelancer2Id
///      where collabFreelancer1Id < collabFreelancer2Id (canonical ordering by numeric ID)
model Conversation {
  id                   Int      @id @default(autoincrement())
  customerId           Int?
  freelancerId         Int?
  collabFreelancer1Id  Int?     // Freelancer with lower ID (canonical ordering)
  collabFreelancer2Id  Int?     // Freelancer with higher ID (canonical ordering)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  customer            User?    @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Cascade)
  freelancer          User?    @relation("FreelancerConversations", fields: [freelancerId], references: [id], onDelete: Cascade)
  collabFreelancer1   User?    @relation("CollabF1Conversations", fields: [collabFreelancer1Id], references: [id], onDelete: Cascade)
  collabFreelancer2   User?    @relation("CollabF2Conversations", fields: [collabFreelancer2Id], references: [id], onDelete: Cascade)
  participants        ConversationParticipant[]
  messages            Message[]
  reports             Report[]  @relation("ReportConversationRelation")

  @@unique([customerId, freelancerId])
  @@unique([collabFreelancer1Id, collabFreelancer2Id])
  @@index([customerId])
  @@index([freelancerId])
  @@index([collabFreelancer1Id])
  @@index([collabFreelancer2Id])
}

/// Junction table: Conversation <-> User (many-to-many)
model ConversationParticipant {
  conversationId Int
  userId         Int
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

/// An individual message within a conversation.
model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String       @db.Text
  isRead         Boolean      @default(false)
  sentAt         DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId])
  @@index([senderId])
  @@index([sentAt])
  @@index([isRead])
}

// =============================================================================
// MODULE 9 — REVIEWS & RATINGS
// =============================================================================

/// A review submitted after a completed contract.
model Review {
  id             Int      @id @default(autoincrement())
  projectId      Int      @unique
  contractId     Int      @unique
  reviewerId     Int
  reviewedUserId Int
  rating         Int      // Application enforces 1-5 range
  comment        String?  @db.Text
  createdAt      DateTime @default(now())

  project        Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  contract       Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  reviewer       User     @relation("ReviewerRelation", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewedUser   User     @relation("ReviewedRelation", fields: [reviewedUserId], references: [id], onDelete: Restrict)

  @@index([reviewedUserId])
  @@index([reviewerId])
  @@index([rating])
  @@index([projectId])
  @@index([contractId])
}

// =============================================================================
// MODULE 11 — REPORTS / COMPLAINTS / MODERATION
// =============================================================================

/// A moderation report filed by one user against another.
model Report {
  id                    Int          @id @default(autoincrement())
  reporterId            Int
  reportedUserId        Int
  resolvedById          Int?
  reason                String
  description           String?      @db.Text
  status                ReportStatus @default(PENDING)
  resolutionNotes       String?      @db.Text
  relatedProjectId      Int?
  relatedConversationId Int?
  createdAt             DateTime     @default(now())
  resolvedAt            DateTime?

  reporter            User          @relation("ReporterRelation", fields: [reporterId], references: [id], onDelete: Restrict)
  reportedUser        User          @relation("ReportedRelation", fields: [reportedUserId], references: [id], onDelete: Restrict)
  resolvedBy          User?         @relation("ResolverRelation", fields: [resolvedById], references: [id], onDelete: SetNull)
  relatedProject      Project?      @relation("ReportProjectRelation", fields: [relatedProjectId], references: [id], onDelete: SetNull)
  relatedConversation Conversation? @relation("ReportConversationRelation", fields: [relatedConversationId], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@index([resolvedById])
  @@index([relatedProjectId])
  @@index([relatedConversationId])
}

// =============================================================================
// OPTIONAL — PAYMENT RECORDS
// =============================================================================

/// Simple in-system payment record linked to a contract.
/// Not integrated with external payment gateway.
model Payment {
  id           Int           @id @default(autoincrement())
  contractId   Int           @unique
  payerId      Int
  receiverId   Int
  amount       Decimal       @db.Decimal(10, 2)
  status       PaymentStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  contract     Contract      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  payer        User          @relation("PayerRelation", fields: [payerId], references: [id], onDelete: Restrict)
  receiver     User          @relation("ReceiverRelation", fields: [receiverId], references: [id], onDelete: Restrict)

  @@index([contractId])
  @@index([payerId])
  @@index([receiverId])
  @@index([status])
}

// =============================================================================
// MODULE 12 — FREELANCER COLLABORATION / INTERNSHIP
// =============================================================================

/// A collaboration opportunity posted by a freelancer seeking other freelancers/interns
model CollaborationOpportunity {
  id                   Int                 @id @default(autoincrement())
  creatorId            Int
  title                String
  roleNeeded           String
  description          String              @db.Text
  expectedContribution String?             @db.Text
  type                 CollaborationType   @default(PROJECT_COLLABORATION)
  compensationType     CompensationType    @default(UNPAID)
  compensation         String?
  workMode             WorkMode            @default(REMOTE)
  location             String?
  duration             String?
  startDate            DateTime?
  endDate              DateTime?
  maxCollaborators     Int                 @default(1)
  requirements         String?             @db.Text
  skills               String?             @db.Text
  status               CollaborationStatus @default(OPEN)
  relatedProjectId     Int?
  completedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  creator              User                     @relation("CollabCreatorRelation", fields: [creatorId], references: [id], onDelete: Cascade)
  relatedProject       Project?                 @relation(fields: [relatedProjectId], references: [id], onDelete: SetNull)
  applications         CollaborationApplication[]
  verifiedWorks        VerifiedCollaboration[]

  @@index([creatorId])
  @@index([status])
  @@index([type])
  @@index([workMode])
  @@index([compensationType])
  @@index([relatedProjectId])
}

/// Application submitted by a freelancer to join a collaboration opportunity
model CollaborationApplication {
  id              Int                            @id @default(autoincrement())
  opportunityId   Int
  applicantId     Int
  message         String                         @db.Text
  status          CollaborationApplicationStatus @default(PENDING)
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  opportunity     CollaborationOpportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicant       User                           @relation("CollabApplicantRelation", fields: [applicantId], references: [id], onDelete: Cascade)
  verifiedWork    VerifiedCollaboration?

  @@unique([opportunityId, applicantId])
  @@index([opportunityId])
  @@index([applicantId])
  @@index([status])
}

/// Verified work history entry generated when a collaboration is successfully completed
model VerifiedCollaboration {
  id               Int                      @id @default(autoincrement())
  freelancerId     Int
  collaboratorId   Int
  opportunityId    Int
  applicationId    Int?                     @unique
  projectTitle     String
  role             String
  skills           String?                  @db.Text
  description      String?                  @db.Text
  duration         String?
  compensationType CompensationType         @default(UNPAID)
  compensation     String?
  isVerified       Boolean                  @default(true)
  completedAt      DateTime                 @default(now())
  createdAt        DateTime                 @default(now())

  freelancer       User                     @relation("VerifiedCollabFreelancer", fields: [freelancerId], references: [id], onDelete: Cascade)
  collaborator     User                     @relation("VerifiedCollabPartner", fields: [collaboratorId], references: [id], onDelete: Cascade)
  opportunity      CollaborationOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  application      CollaborationApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([freelancerId])
  @@index([collaboratorId])
  @@index([opportunityId])
}

// =============================================================================
// MODULE 13 — CUSTOMER CARE / SUPPORT TICKETS
// =============================================================================

/// Support ticket submitted by a customer or freelancer to platform administration
model SupportTicket {
  id               Int                 @id @default(autoincrement())
  userId           Int
  subject          String
  category         SupportCategory     @default(OTHER)
  priority         SupportPriority     @default(MEDIUM)
  status           SupportTicketStatus @default(OPEN)
  description      String              @db.Text
  relatedProjectId Int?
  adminNotes       String?             @db.Text
  resolvedById     Int?
  resolvedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user             User                @relation("TicketUserRelation", fields: [userId], references: [id], onDelete: Cascade)
  relatedProject   Project?            @relation("TicketProjectRelation", fields: [relatedProjectId], references: [id], onDelete: SetNull)
  resolvedBy       User?               @relation("TicketResolverRelation", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([resolvedById])
  @@index([relatedProjectId])
}

